# ============================================================================
# EXPANSION ADS AGENT — variaveis de ambiente
# Copie para .env e preencha localmente. NUNCA versione o .env.
# Nenhum valor real deve existir neste arquivo.
# ============================================================================

# --- Meta / Graph API -------------------------------------------------------
# Token de acesso de usuario de sistema do Business Manager.
# Escopos minimos: ads_management, ads_read, business_management,
# pages_show_list, pages_read_engagement, instagram_basic.
META_ACCESS_TOKEN=

# App da Meta (usado para appsecret_proof e diagnostico). Opcionais no MVP.
META_APP_ID=
META_APP_SECRET=

# Versao da Graph API. Mantida configuravel de proposito.
# Formato obrigatorio: vNN.N
META_GRAPH_API_VERSION=v26.0

# Host da Graph API (nao altere sem motivo).
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# --- Seguranca de execucao --------------------------------------------------
# DRY_RUN=true nao cria NADA na Meta. Padrao: true. So mude conscientemente.
DRY_RUN=true

# Exige appsecret_proof em todas as chamadas (requer META_APP_SECRET).
META_REQUIRE_APPSECRET_PROOF=false

# Timeout por requisicao (ms) e politica de retry.
META_REQUEST_TIMEOUT_MS=30000
META_MAX_RETRIES=4
META_RETRY_BASE_DELAY_MS=1000

# --- Persistencia -----------------------------------------------------------
# Driver de persistencia. MVP: sqlite.
DB_DRIVER=sqlite
DB_PATH=./data/expansion-ads.sqlite

# --- Logs -------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
LOG_PRETTY=false

# --- Aprovacao --------------------------------------------------------------
# Validade padrao da aprovacao, em horas.
APPROVAL_TTL_HOURS=24
# Identificacao de quem opera (vai para a auditoria).
OPERATOR_ID=operador-local

# --- Automacoes (todas desligadas por padrao) -------------------------------
HEADLESS_ENABLED=false
AUTO_PAUSE_ENABLED=false
AUTO_SCALE_ENABLED=false
AUTO_REACTIVATE_ENABLED=false

# --- Caminhos ---------------------------------------------------------------
CLIENTS_DIR=./clients
BRIEFS_DIR=./briefs
CREATIVES_DIR=./creatives
POLICIES_DIR=./policies
REPORTS_DIR=./reports
